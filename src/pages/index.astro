---
const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '');
const canonical = siteUrl
  ? new URL(Astro.url.pathname, `${siteUrl}/`).toString()
  : undefined;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const googleAnalyticsId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID?.trim();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="yuzumoneが提供する東京ディズニーリゾート向けの便利ツール" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content="yuzumone.net" />
    <meta property="og:description" content="東京ディズニーリゾート向けの便利ツール" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" />
    <title>yuzumone.net</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2280%22>✦</text></svg>" />
    {
      adsenseClient && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${encodeURIComponent(adsenseClient)}`}
          crossorigin="anonymous"
        />
      )
    }
    {
      googleAnalyticsId && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(googleAnalyticsId)}`}
          />
          <script is:inline define:vars={{ googleAnalyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', googleAnalyticsId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="header-inner"><a class="site-name" href="/">DISNEY RESORT Tools</a></div>
    </header>
    <main id="main-content">
      <section class="home content-shell" aria-label="ツール一覧">
        <ul class="tool-grid">
          <li>
            <a class="tool-card" href="/restaurant_link/">
              <span class="tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M8 3v18M5 3v7a3 3 0 006 0V3M16 3v8M16 11a3 3 0 013 3v7M16 11a3 3 0 00-3 3v2a3 3 0 003 3h3" /></svg>
              </span>
              <span><strong>Restaurant Link</strong><small>レストラン予約リンクを作成</small></span>
              <svg class="arrow" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5" /></svg>
            </a>
          </li>
        </ul>
      </section>
    </main>
    <footer class="site-footer"><div class="footer-inner"><p>© 2026 yuzumone</p><a href="https://yuzumone.net/">yuzumone.net</a></div></footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; --ink: #252525; --muted: #696969; --paper: #fff; --line: #e5e5e5; --accent: #2196f3; --max-width: 760px; font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic", Meiryo, sans-serif; font-synthesis: none; text-rendering: optimizeLegibility; }
  * { box-sizing: border-box; }
  html { min-width: 320px; min-height: 100%; color: var(--ink); background: var(--paper); }
  body { min-height: 100vh; margin: 0; display: flex; flex-direction: column; font-size: 16px; line-height: 1.8; }
  a { color: var(--accent); text-underline-offset: .2em; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 2px; }
  .skip-link { position: fixed; z-index: 100; top: .75rem; left: .75rem; padding: .5rem .75rem; color: white; background: var(--ink); transform: translateY(-160%); }
  .skip-link:focus { transform: translateY(0); }
  .site-header { border-bottom: 1px solid var(--line); background: var(--paper); }
  .header-inner, .footer-inner, .content-shell { width: min(calc(100% - 2.5rem), var(--max-width)); margin-inline: auto; }
  .header-inner { min-height: 64px; display: flex; align-items: center; }
  .site-name { color: var(--ink); font-size: 1rem; font-weight: 700; text-decoration: none; }
  main { flex: 1; }
  .home { min-height: calc(100vh - 174px); display: flex; align-items: center; flex-direction: column; justify-content: center; padding-block: 4rem; text-align: center; }
  .tool-grid { width: min(100%, 420px); margin: 0; padding: 0; list-style: none; }
  .tool-card { min-height: 80px; padding: 14px 16px; display: grid; grid-template-columns: 46px 1fr 24px; align-items: center; gap: 14px; border: 1px solid #d4d4d4; border-radius: 16px; color: var(--ink); background: var(--paper); text-align: left; text-decoration: none; transition: .18s ease; }
  .tool-card:hover { border-color: var(--accent); background: #f5faff; box-shadow: 0 5px 18px rgba(33, 150, 243, .12); }
  .tool-icon { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; color: var(--accent); background: #e3f2fd; }
  .tool-icon svg, .arrow { width: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .tool-card strong, .tool-card small { display: block; }
  .tool-card strong { font-size: .95rem; }
  .tool-card small { margin-top: 1px; color: var(--muted); font-size: .72rem; }
  .arrow { width: 19px; color: var(--accent); }
  .site-footer { padding-block: 1.5rem; border-top: 1px solid var(--line); }
  .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .footer-inner p, .footer-inner a { margin: 0; color: var(--muted); font-size: .78rem; }
  .footer-inner a { text-decoration: none; }
  .footer-inner a:hover { color: var(--ink); text-decoration: underline; }
  @media (max-width: 640px) { .header-inner { min-height: 58px; } .home { min-height: auto; padding-block: 5rem; } .footer-inner { align-items: flex-start; flex-direction: column; gap: .75rem; } }
</style>
